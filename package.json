{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:db": "pglite-server -p 51214 -d prisma/pgdata -m 100",
    "dev:next": "next dev -H 0.0.0.0 --webpack",
    "dev:bot": "cd bot && npm run start",
    "dev": "concurrently \"npm run dev:db\" \"npm run dev:next\" \"npm run dev:bot\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
